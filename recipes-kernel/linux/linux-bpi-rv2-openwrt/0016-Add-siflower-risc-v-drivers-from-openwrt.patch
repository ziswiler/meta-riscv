+				reg_read(priv, XGMAC_DMA_CH_RxDESC_LADDR(j)),
+				reg_read(priv, XGMAC_DMA_CH_RxDESC_TAIL_LPTR(j)));
+		seq_printf(m, "                     Cur desAddr:0x%x bufAddr:0x%x\n",
+				reg_read(priv, XGMAC_DMA_CH_CUR_RxDESC_LADDR(j)),
