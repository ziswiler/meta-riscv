# short-description: Create USB stick image for Banana Pi BPI-RV2 board

bootloader --ptable gpt
part /boot --source bootimg-partition --sourceparams="loader=u-boot" --ondisk sda1 --fstype=vfat --label boot --use-uuid --active --fixed-size 128M --align 4096
part / --source rootfs --ondisk sda2 --fstype=ext4 --label root --use-uuid --align 4096 --part-type 72ec70a6-cf74-40e6-bd49-4bda08e8f224
